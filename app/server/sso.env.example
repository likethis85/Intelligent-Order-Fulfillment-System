# Copy to server/.env.sso and fill server-only credentials from the SSO admin.
# Existing server/.env and business settings do not need to change.
SSO_BASE_URL=https://sso.marius.com.cn
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:3700/api/auth/sso/callback
SSO_REDIRECT_URIS=http://127.0.0.1:3700/api/auth/sso/callback
# Use HTTPS for both SSO_BASE_URL and the project callback in production.
