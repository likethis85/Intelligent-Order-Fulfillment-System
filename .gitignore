# macOS
.DS_Store

# Claude Code local session data (do not commit)
.claude/

# Backup files
app/package-lock.json.bak

# 样衣 BOM 运行时缓存（按款号，自动重建）
app/server/data/sample-bom-cache.json

# 参考项目（不纳入版本控制）
reference/

# 部署脚本与配置（不纳入版本控制）
/deploy/
deploy.mjs
deploy.ps1
deploy.sh
deploy.tar.gz

# 钉钉与 DWS 凭据（敏感信息，不纳入版本控制）
app/server/data/dws-credentials/
app/server/data/dingtalk-storage-state.json

# 权限体系运行时数据（含真实姓名与登录记录，由服务首次启动自动重建）
app/server/data/access-control.json
app/server/data/access-users.json
app/server/data/access-audit.json

# Scratch files and temporary test scripts
scratch/

